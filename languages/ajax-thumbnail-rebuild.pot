#: assets/js/admin.js:194
#, js-format
msgid "Attachment %d"
msgstr ""

#: assets/js/admin.js:218
#: assets/js/cleanup.js:117
msgid "Reading the media library…"
msgstr ""

#: assets/js/admin.js:239
msgid "No images match those settings."
